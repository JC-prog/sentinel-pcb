# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Env / secrets
.env
.env.*
!.env.example

# OS
.DS_Store

# Uploaded chat images (app.settings.chat_upload_dir) - runtime data, not source.
/data/uploads/

# Rotating log files (settings.log_to_file / settings.log_dir) - runtime output, not source.
/data/logs/

# ONNX files the inference service downloads from Hugging Face (inference/scripts/fetch_models.py).
# Fetched at image build time, never committed.
/inference/model_store/
# Large model binaries under models/ (e.g. pcb_feature_detector.onnx) are fetched from Hugging
# Face, never committed. Small labels/config JSON alongside them stays tracked.
/models/*.onnx

# Local ML datasets and runtime capture images - not source. Model training lives in the
# separate PCB-Object-Detection-App repo; these are downloaded or generated, never committed.
/data/ADC_Final/
/data/images/*.png
/data/images/*.jpg
/data/images/*.jpeg

# Explainability & Review Agent (app.settings.explainability_agent_data_dir) - PCB images,
# generated telemetry, and the embedded Qdrant DB are runtime data, not source. ipc_standards/ is
# a committed reference document, so it's excluded from this ignore.
/data/images/inputs/*
!/data/images/inputs/.gitkeep
/data/images/outputs/
/data/images/qdrant_db/

# Planning docs (proposals, reports, working design docs) - not part of the shipped repo.
planning/

# Terraform (infra/production/) - local provider cache and any local state/plan output.
# .terraform.lock.hcl (provider version pins) is NOT ignored - that's meant to be committed.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json
# tfvars can carry real secrets (e.g. var.openai_api_key) - never commit them.
*.tfvars
*.auto.tfvars
*_override.tf
*_override.tf.json

# Editors
.vscode/
.idea/
