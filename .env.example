# Copy to .env and fill in. Never commit .env.

# LLM provider
ANTHROPIC_API_KEY=

# Database. For bare local dev (uv run uvicorn ...), point this at the docker-compose "db"
# service's host port: postgresql+asyncpg://sentinelpcb:sentinelpcb@localhost:5433/sentinelpcb
# Under `docker compose up`, docker-compose.yml's own `environment:` override takes precedence
# over this file and points the app container at "db:5432" instead - only matters when running
# outside compose. Production may instead point this at a Supabase Postgres (also hosts pgvector
# for Case Context, once that's built).
DATABASE_URL=postgresql+asyncpg://sentinelpcb:sentinelpcb@localhost:5433/sentinelpcb

# Cache / queue (Upstash Redis)
REDIS_URL=

# LLM observability (optional in local dev)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sentinel-pcb

# Local/offline reasoning fallback
OLLAMA_BASE_URL=http://localhost:11434
