# Copy to .env and fill in as needed. JWT_SECRET_KEY and OPENAI_API_KEY below are real secrets
# you must set for their respective features to work - never commit real values for either.

# ui/ (Angular) dev server origin, as a JSON array. Add the deployed origin once one exists.
CORS_ALLOW_ORIGINS=["http://localhost:4200"]

# Local LLM (Ollama). Defaults assume Ollama is running natively on your machine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI - a single server-side key, used wherever OpenAI is needed: chat when a user picks the
# OpenAI provider, long-term memory's embeddings/fact-extraction (same case), and the
# Explainability & Review Agent. No per-request bring-your-own-key - whoever runs this server
# configures this once. Leave empty to disable the OpenAI provider entirely (Ollama still works).
OPENAI_API_KEY=

# Database (app/db/, used by auth and by per-conversation chat memory - see alembic/ for
# migrations). For bare local dev (uv run uvicorn ...), point this at docker-compose's "db"
# service's host port: postgresql+asyncpg://sentinelchat:sentinelchat@localhost:5433/sentinelchat
# Under `docker compose -f infra/development/docker-compose.yml up`, that file's own
# `environment:` override takes precedence and points the app container at "db:5432" instead -
# only matters when running outside compose.
DATABASE_URL=postgresql+asyncpg://sentinelchat:sentinelchat@localhost:5433/sentinelchat

# Auth (app/auth/). Generate a real value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The app refuses to issue usable tokens with an empty key - never commit a real value here.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# False in dev (plain HTTP over localhost). Set True in production, where the UI and API share
# one HTTPS CloudFront domain (infra/production/static_site.tf).
COOKIE_SECURE=False

# Vector store (Qdrant) for long-term, cross-conversation memory (app/memory/). For bare local
# dev this already points at docker-compose's "qdrant" service's host port; under
# `docker compose -f infra/development/docker-compose.yml up`, that file's own `environment:`
# override points the app container at "qdrant:6333" instead.
QDRANT_URL=http://localhost:6333

# Long-term memory (app/memory/). MEMORY_ENABLED is a kill switch - set False to turn it off
# without touching code. The embedding model settings must match a model you've actually pulled
# (`ollama pull nomic-embed-text`) if using the Ollama provider.
MEMORY_ENABLED=True
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Explainability & Review Agent (app/agents/explainability_review_agent/). Uses the shared
# OPENAI_API_KEY above, not a key of its own. Data (PCB images, generated telemetry, the embedded
# Qdrant DB) lives under EXPLAINABILITY_AGENT_DATA_DIR - see DEVELOPMENT.md.
EXPLAINABILITY_AGENT_ENABLED=True
EXPLAINABILITY_AGENT_DATA_DIR=data/images

# Logging (app/config/logging_config.py). "console" is readable in a local terminal; set to
# "json" in production so ECS Fargate's awslogs log driver ships parseable lines to CloudWatch.
# Same stdout destination either way - only the format changes.
LOG_FORMAT=console
