# Copy to .env and fill in as needed. JWT_SECRET_KEY and OPENAI_API_KEY below are secrets you
# must set for their respective features to work - never commit real values for either.
# setup-dev.sh generates a JWT_SECRET_KEY for you if it's still blank.

# ui/ (Angular) dev server origin, as a JSON array. Add the deployed origin once one exists.
CORS_ALLOW_ORIGINS=["http://localhost:4200"]

# Local LLM (Ollama). Defaults assume Ollama is running natively on your machine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ONNX classification microservice (inference/ - its own project, separate pyproject/venv/CI).
# Blank by default: every feature that calls it (inspect_image, the Work tab, the Models tab)
# degrades gracefully - "not configured" instead of an error - rather than needing it. Set this
# to actually reach it: http://localhost:8001 for a natively-run `uv run uvicorn ...` (see
# inference/README.md, or infra/development/scripts/*/start-dev.*), unchanged if you instead run
# it via `docker compose ... --profile inference up -d` (that profile publishes the same port).
INFERENCE_BASE_URL=

# LLM gateway. The app calls OPENAI_BASE_URL (a LiteLLM proxy), never api.openai.com directly -
# for chat (OpenAI provider), long-term memory embeddings/fact-extraction, and the Explainability
# & Review Agent. OPENAI_API_KEY here is the proxy key, not an sk- provider key.
#
# The proxy runs in Docker as part of the dev stack (infra/development/docker-compose.yml). These
# defaults point at it; the containerized app overrides the host to http://litellm:4000/v1.
OPENAI_BASE_URL=http://localhost:4000/v1
OPENAI_API_KEY=sk-litellm-dev

# Your own OpenAI key - used only by your LOCAL proxy container to reach OpenAI upstream. It
# never goes into app config and .env is git-ignored. Leave blank to work Ollama-only (OpenAI
# calls 401 until it's set). In production one shared key lives in Secrets Manager instead.
LITELLM_OPENAI_API_KEY=

# Prefer a shared team proxy over the local one? Point OPENAI_BASE_URL at it and set
# OPENAI_API_KEY to the key from your team vault; LITELLM_OPENAI_API_KEY is then unused.

# Database (app/db/, used by auth and by per-conversation chat memory - see alembic/ for
# migrations). For bare local dev (uv run uvicorn ...), point this at docker-compose's "db"
# service's host port: postgresql+asyncpg://sentinelchat:sentinelchat@localhost:5433/sentinelchat
# Under `docker compose -f infra/development/docker-compose.yml up`, that file's own
# `environment:` override takes precedence and points the app container at "db:5432" instead -
# only matters when running outside compose.
DATABASE_URL=postgresql+asyncpg://sentinelchat:sentinelchat@localhost:5433/sentinelchat

# Auth (app/auth/). Generate a real value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The app refuses to issue usable tokens with an empty key - never commit a real value here.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# False in dev (plain HTTP over localhost). Set True in production, where the UI and API share
# one HTTPS CloudFront domain (infra/production/static_site.tf).
COOKIE_SECURE=False

# Vector store (Qdrant) for long-term, cross-conversation memory (app/memory/). For bare local
# dev this already points at docker-compose's "qdrant" service's host port; under
# `docker compose -f infra/development/docker-compose.yml up`, that file's own `environment:`
# override points the app container at "qdrant:6333" instead.
QDRANT_URL=http://localhost:6333

# Long-term memory (app/memory/). MEMORY_ENABLED is a kill switch - set False to turn it off
# without touching code. The embedding model settings must match a model you've actually pulled
# (`ollama pull nomic-embed-text`) if using the Ollama provider.
MEMORY_ENABLED=True
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Explainability & Review Agent (app/agents/explainability_review_agent/). Uses the shared
# OPENAI_API_KEY above, not a key of its own. Data (PCB images, generated telemetry, the embedded
# Qdrant DB) lives under EXPLAINABILITY_AGENT_DATA_DIR - see DEVELOPMENT.md.
EXPLAINABILITY_AGENT_ENABLED=True
EXPLAINABILITY_AGENT_DATA_DIR=data/images

# Weather agent (app/agents/weather_agent/). Kill switch, same pattern as above - False skips
# only the LLM-written advisory (a templated summary is used instead); current conditions and
# the forecast are unaffected. Uses the shared OPENAI_API_KEY above, not a key of its own.
WEATHER_ADVISORY_ENABLED=True

# Chat guardrails (app/chat/guardrails/) - a NeMo Guardrails input rail checking every user
# message for jailbreak/prompt-injection attempts and off-topic requests before it reaches the
# intent router or any chat LLM call. Kill switch, same pattern as above. Uses the shared
# OPENAI_API_KEY/OPENAI_BASE_URL above, not a key of its own - CHAT_GUARDRAILS_MODEL is
# independently tunable since the check is a small classification task a cheaper model can handle.
CHAT_GUARDRAILS_ENABLED=True
CHAT_GUARDRAILS_MODEL=gpt-4o-mini

# Work tab's Orchestrator agent (app/workflow/src/agent1_orchestrator/) - QA/Admin-only bulk
# dataset workflow, unrelated to chat. Its "Use real LLM Planner" option is off (deterministic
# planner) unless you set a real key here - unlike every other agent above, it calls
# api.openai.com directly rather than going through OPENAI_BASE_URL's LiteLLM proxy, so it needs
# its own sk-... key, not the shared OPENAI_API_KEY. Leave blank to use the deterministic planner
# only (no error either way).
ORCHESTRATOR_OPENAI_API_KEY=
ORCHESTRATOR_OPENAI_MODEL=gpt-5.6-luna

# Self-hosted LangFuse tracing for the LangGraph pipelines only (app/config/langfuse.py) - kill
# switch, off by default. `docker compose -f infra/development/docker-compose.yml --env-file .env
# --profile langfuse up -d --wait` brings up the stack and auto-provisions an org/project/API-key
# pair matching the values below (see that file's langfuse-web headless-init env vars) - no
# manual UI setup needed. Log in at http://localhost:3000 with dev@sentinelchat.local /
# sentinelchat-dev-password to browse traces.
LANGFUSE_ENABLED=False
LANGFUSE_PUBLIC_KEY=pk-lf-sentinelchat-dev
LANGFUSE_SECRET_KEY=sk-lf-sentinelchat-dev
LANGFUSE_HOST=http://localhost:3000

# Logging (app/config/logging_config.py). "console" is readable in a local terminal; set to
# "json" in production so ECS Fargate's awslogs log driver ships parseable lines to CloudWatch.
# Same stdout destination either way - only the format changes.
LOG_FORMAT=console
# DEBUG unlocks verbose logging: every API request/response body (with `password` redacted -
# app/main.py's request-logging middleware) and every LLM request/response payload, including
# the `tools` array and tool-call results (app/chat/providers/). Off by default - full bodies are
# noisy and this is meant for local troubleshooting, not always-on production logging.
LOG_LEVEL=INFO

# Also write logs to a rotating file (LOG_DIR/app.log, 10 MiB x 5 backups) alongside stdout - off
# by default. Only host-visible for bare `uv run uvicorn`, not the containerized `app` service
# (data/ isn't volume-mounted there), same caveat as chat uploads / explainability agent data.
LOG_TO_FILE=False
LOG_DIR=data/logs
