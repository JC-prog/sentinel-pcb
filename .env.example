# Copy to .env and fill in. Never commit .env.

# LLM provider
ANTHROPIC_API_KEY=

# Database (Supabase Postgres, also hosts pgvector for Case Context)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Cache / queue (Upstash Redis)
REDIS_URL=

# LLM observability (optional in local dev)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sentinel-pcb

# Local/offline reasoning fallback
OLLAMA_BASE_URL=http://localhost:11434
